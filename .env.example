# =====================================================================
# LLM-as-Judge pipeline configuration  (copy to .env; never commit .env)
# =====================================================================
# Groq API key (free key at https://console.groq.com). SECRET - do not paste it anywhere else.
GROQ_API_KEY=your_groq_api_key_here

# Judge and generator are configured independently and should be DIFFERENT model families
# (self-enhancement guard in judge/config.py refuses a same-family pair unless --allow-same-family).
JUDGE_MODEL=openai/gpt-oss-120b
GENERATOR_MODEL=qwen/qwen3.8-27b

# Judge inference settings
JUDGE_TEMPERATURE=0
JUDGE_MAX_TOKENS=1500
JUDGE_PASS_THRESHOLD=3.5

# Audit log (every judge prompt + raw response); committed as evidence. Default shown.
# JUDGE_LOG=judge/logs/judge_calls.jsonl
# Live web-playground log (git-ignored)
# JUDGE_WEB_LOG=judge/logs/web_calls.jsonl
