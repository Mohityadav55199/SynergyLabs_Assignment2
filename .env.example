# =====================================================================
# LLM-as-Judge Evaluation Pipeline Configuration
# =====================================================================

# Primary LLM Judge Provider: "groq", "openai", or "mock"
LLM_PROVIDER=groq

# Groq API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=

# Model Configurations (Judge and Generator configured independently)
JUDGE_MODEL=llama-3.3-70b-versatile
GENERATOR_MODEL=llama-3.1-8b-instant

# Inference Parameters
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=2048

# Judge Bias Mitigation Flags
ENABLE_POSITION_SWAP_MITIGATION=true
ENABLE_VERBOSITY_PENALTY=true
ENABLE_EVIDENCE_GROUNDING=true
ENABLE_ANCHOR_CALIBRATION=true

# Multi-Tier Resilient Fallback Engine
ENABLE_FALLBACK=true
FALLBACK_MODELS=llama-3.1-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768

# Evaluation Thresholds
PASS_THRESHOLD=3.5
CONFIDENCE_THRESHOLD=0.7

# Output & Logging
LOG_LEVEL=INFO
ARTIFACTS_DIR=./artifacts
AUDIT_LOGS_DIR=./artifacts/audit_logs
